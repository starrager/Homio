{
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "lib": ["ES2020"],
      "outDir": "./dist",
      "rootDir": "./src",
      "strict": false,
      "esModuleInterop": true,
      "types": ["node"],
      "skipLibCheck": true,
      "noImplicitAny": false,
      "strictNullChecks": false,
      "noUnusedLocals": false,
      "noUnusedParameters": false,
      "resolveJsonModule": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"],
    "typeAcquisition": {
      "enable": false
    }
  }